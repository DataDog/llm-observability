# Eve model via Vercel AI Gateway
# Run `npm exec -- eve link` to populate VERCEL_OIDC_TOKEN, or set AI_GATEWAY_API_KEY.
# AI_GATEWAY_API_KEY=

# Stock watchlist research tools call OpenAI Responses API directly for function-calling and web search.
OPENAI_API_KEY=sk-...
# Optional model overrides
# OPENAI_MODEL=gpt-4o
# OPENAI_SEARCH_MODEL=gpt-4o-mini
# OPENAI_EVAL_MODEL=gpt-4o-mini

# Optional Datadog LLM Observability, OpenTelemetry export, and eval experiment reporting
# DD_API_KEY=<your-datadog-api-key>
# DD_APP_KEY=<your-datadog-application-key> # required for Datadog eval experiment reporting
DD_SITE=datadoghq.com
DD_LLMOBS_ML_APP=stock-watchlist-agent-eve
DD_LLMOBS_ENABLED=true
DD_LLMOBS_AGENTLESS_ENABLED=true
DD_ENV=dev
# Standalone LLMObs mode: do not send regular APM traces to a local Datadog Agent.
DD_APM_TRACING_ENABLED=false

# Eve's provider-layout OpenTelemetry instrumentation emits schema-v4 GenAI
# spans and exports them through OTLP directly to Datadog when DD_API_KEY is set.
# Override this for a local collector or custom endpoint.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_SERVICE_NAME=stock-watchlist-agent-eve
EVE_OTEL_RECORD_INPUTS=false
EVE_OTEL_RECORD_OUTPUTS=false
# Print sanitized OTLP span batches and exporter result codes for backend lookup.
EVE_OTEL_DEBUG_PAYLOADS=false

# Eve eval Datadog experiment reporter. Enabled automatically when both
# DD_API_KEY and DD_APP_KEY are present; set false to force-disable.
# DD_EVE_EVAL_EXPERIMENTS_ENABLED=true
# DD_EVE_EVAL_EXPERIMENT_NAME=stock-watchlist-agent-eve-local

# Optional service name shown in APM/trace metadata
DD_SERVICE=stock-watchlist-agent-eve
