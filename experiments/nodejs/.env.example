# Datadog credentials
DD_API_KEY=
DD_APP_KEY=
# DD_APPLICATION_KEY also works if DD_APP_KEY is not set

# Datadog site
DD_SITE=datadoghq.com
DD_LLMOBS_PROJECT_NAME=nodejs-experiments-examples

# LLM provider credentials for experiment trace examples
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional: OpenTelemetry support for examples/05-otel-openai-experiment.js
# The npm script sets DD_TRACE_OTEL_ENABLED=1 so dd-trace can act as the OTel TracerProvider.
# Set this explicitly if you run the file without npm.
# DD_TRACE_OTEL_ENABLED=1
# OTEL_SERVICE_NAME=nodejs-experiments-examples

